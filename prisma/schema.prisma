generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Review {
  id        Int      @id @default(autoincrement())
  eventId   Int      // Зв'язок з вашим events.json
  rating    Int      // 1-5 зірок
  comment   String?
  createdAt DateTime @default(now())
}